# Fill these in before starting the app.

# MySQL database from cPanel -> MySQL Databases.
# Use the FULL prefixed names, e.g. myuser_belaview
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=

# The client site's public URL exactly as users open it (no trailing slash),
# e.g. https://belaview.com - leave empty to skip the JWT issuer check.
AUTH_BASE_URL=

# This API's public URL (no trailing slash), e.g. https://api.belaview.com
# Leave empty to build uploaded-image links from the incoming request.
MEDIA_BASE_URL=

# cPanel/Passenger provides its own port; this is only a local fallback.
PORT=5000
